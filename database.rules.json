{
  "rules": {

    "flowers": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val()))",
      "$flowerId": {
        ".validate": "newData.hasChildren(['name','price','category']) && newData.child('price').isNumber() && newData.child('price').val() > 0 && newData.child('name').val().length > 0"
      }
    },

    "orders": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val()))",
      ".indexOn": ["uid", "status", "timestamp"],
      "$orderId": {
        ".read": "auth != null && ((data.child('uid').val() === auth.uid && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val())) || (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val())))",
        ".write": "(!data.exists() && newData.exists()) || (auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val())))",
        ".validate": "newData.hasChildren(['items','total','timestamp']) && newData.child('total').isNumber() && newData.child('total').val() > 0 && ((auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val()))) || ($orderId.matches(/^[-_A-Za-z0-9]{20}$/) && newData.child('status').val() === 'pending' && newData.child('paymentStatus').val() === 'pending payment' && !newData.hasChild('paidAt') && !newData.hasChild('stockApplied') && !newData.hasChild('paymentSession') && !newData.hasChild('priceCheck') && !newData.hasChild('notifiedAt') && !newData.hasChild('lastPaymentAttempt') && !newData.hasChild('source') && !newData.hasChild('offline') && (!newData.hasChild('uid') || (auth != null && newData.child('uid').val() === auth.uid))))"
      }
    },

    "order-tracking": {
      ".indexOn": ["trackingId"],
      "$orderId": {
        ".read": true,
        ".write": "(!data.exists() && newData.exists()) || (auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val())))",
        ".validate": "newData.hasChildren(['status','timestamp']) && ((auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val()))) || ($orderId.matches(/^[-_A-Za-z0-9]{20}$/) && newData.child('status').val() === 'pending' && !newData.hasChild('paymentStatus') && root.child('orders').child($orderId).exists()))"
      }
    },

    "user-orders": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val())",
        ".write": "auth != null && auth.uid === $uid && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val())",
        "$orderId": {
          ".validate": "newData.val() === true && $orderId.matches(/^[-_A-Za-z0-9]{20}$/)"
        }
      }
    },

    "carts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val())",
        ".write": "auth != null && auth.uid === $uid && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val())"
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && ((auth.uid === $uid && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val())) || (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val())))",
        ".write": "auth != null && auth.uid === $uid && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val())",
        "role": {
          ".write": "auth != null && ((root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val())) || !data.exists())",
          ".validate": "newData.val() === 'user' || (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val()))"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 254"
        },
        "createdAt": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "wishlist": {},
        "phone": {
          ".validate": "newData.isString() && newData.val().matches(/^[+0-9 ()-]{6,20}$/)"
        },
        "photoURL": {
          ".validate": "newData.isString() && newData.val().length <= 600 && newData.val().beginsWith('https://firebasestorage.googleapis.com/v0/b/flowershop-d26f4.firebasestorage.app/o/avatars%2F' + $uid + '%2F') && newData.val().replace('https://firebasestorage.googleapis.com/v0/b/flowershop-d26f4.firebasestorage.app/o/avatars%2F' + $uid + '%2F', '').matches(/^[A-Za-z0-9_.-]+[?]alt=media&token=[A-Za-z0-9-]+$/)"
        },
        "updatedAt": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "sessionsRevokedAt": { ".validate": false },
        "lastAdminSignIn": { ".validate": false },
        "$other": {
          ".validate": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val()))"
        }
      }
    },

    "reviews": {
      ".read": true,
      ".indexOn": ["timestamp"],
      "$reviewId": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && (data.child('uid').val() === auth.uid || (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val()))))",
        ".validate": "$reviewId.matches(/^[-_A-Za-z0-9]{20}$/) && newData.hasChildren(['name','rating','text','timestamp']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 60 && newData.child('rating').isNumber() && newData.child('rating').val() >= 1 && newData.child('rating').val() <= 5 && newData.child('text').isString() && newData.child('text').val().length >= 10 && newData.child('text').val().length <= 500 && newData.child('timestamp').isNumber() && newData.child('timestamp').val() <= now + 300000 && (!newData.hasChild('uid') || (auth != null && newData.child('uid').val() === auth.uid)) && ((auth == null && newData.child('isGuest').val() === true) || (auth != null && newData.child('isGuest').val() !== true))",
        "name": {}, "rating": {}, "text": {}, "timestamp": {}, "uid": {}, "isGuest": {},
        "$other": { ".validate": false }
      }
    },

    "contactMessages": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val()))",
      ".indexOn": ["sentAt"],
      "$messageId": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val())))",
        ".validate": "(auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val()))) || ($messageId.matches(/^[-_A-Za-z0-9]{20}$/) && newData.hasChildren(['name','message','sentAt']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 100 && newData.child('message').isString() && newData.child('message').val().length > 0 && newData.child('message').val().length <= 2000 && newData.child('sentAt').isString() && newData.child('sentAt').val().length <= 40 && (!newData.hasChild('email') || (newData.child('email').isString() && newData.child('email').val().length <= 200)) && (!newData.hasChild('phone') || (newData.child('phone').isString() && newData.child('phone').val().length <= 40)) && (!newData.hasChild('subject') || (newData.child('subject').isString() && newData.child('subject').val().length <= 60)) && newData.child('status').val() === 'unread')",
        "name": {}, "phone": {}, "email": {}, "subject": {}, "message": {}, "sentAt": {}, "status": {},
        "$other": {
          ".validate": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val()))"
        }
      }
    },

    "productWishlists": {
      ".read": true,
      "$productId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === true && root.child('flowers').child($productId).exists()"
        }
      }
    },

    "coupons": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val()))",
      "$couponId": {
        ".validate": "newData.hasChildren(['code','type','label','active'])"
      }
    },

    "priceImports": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val()))",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val()))"
    },

    "agents": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val()))",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val()))",
      "$agentCode": {
        ".validate": "$agentCode.matches(/^[A-Z0-9]{4}$/) && newData.hasChildren(['code','name','commissionRate','active']) && newData.child('commissionRate').isNumber() && newData.child('commissionRate').val() >= 0 && newData.child('commissionRate').val() <= 100"
      }
    },

    "adminLogins": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val()))",
      ".indexOn": ["at"]
    },

    "agent-codes": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' && (!root.child('users').child(auth.uid).child('sessionsRevokedAt').exists() || auth.token.auth_time * 1000 >= root.child('users').child(auth.uid).child('sessionsRevokedAt').val()))",
      "$agentCode": {
        ".validate": "$agentCode.matches(/^[A-Z0-9]{4}$/) && newData.hasChildren(['name','active'])"
      }
    }

  }
}
